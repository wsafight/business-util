{
  "name": "business-util",
  "version": "2.0.0",
  "description": "记录实用工具",
  "author": "wsafight",
  "license": "ISC",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "bun run check:content && astro check",
