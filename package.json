    "astro": "astro",
    "gen-readme": "bun ./gen-readme.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/starlight": "0.39.2",
    "astro": "6.3.7",
    "sharp": "0.34.5",
    "starlight-image-zoom": "0.14.2"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "6.0.3"
  }
}
